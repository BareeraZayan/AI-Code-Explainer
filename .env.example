# Copy this file to .env and paste your key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq retired llama-3.3-70b-versatile for free/developer tiers (Aug 2026).
# If /explain returns a model-not-found error, try:
# GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL=llama-3.3-70b-versatile
